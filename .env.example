# Copy to .env and export before a live run. Never commit a real key.
#   set -a && source .env && set +a
ANTHROPIC_API_KEY=

# Optional overrides. Defaults live in collection_qa.llm and collection_qa.embeddings.
COLLECTION_QA_MODEL=claude-sonnet-5-5
COLLECTION_QA_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional. A Slack user token (search:read) for MMP / go-live context.
# Leave empty to skip Slack. Never commit a real token.
SLACK_TOKEN=
